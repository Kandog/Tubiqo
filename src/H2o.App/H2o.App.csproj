<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\H2o.Core\H2o.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode (Fluent, follows Windows light/dark) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>h2o</AssemblyName>
  </PropertyGroup>

</Project>
