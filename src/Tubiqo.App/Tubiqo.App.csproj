<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tubiqo.Core\Tubiqo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode (Fluent, follows Windows light/dark) is still marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>Tubiqo</AssemblyName>
    <!-- The app version "Check for updates" compares against releases. Bump it for every release. -->
    <Version>0.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lean Player page, served from the app folder at https://player.tubiqo.test/ -->
    <Content Include="Player\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Scripts Tubiqo injects into pages -->
    <Content Include="Scripts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in Rule Pack, compiled into the app so it can't be edited on disk. -->
    <EmbeddedResource Include="Rules\default-rulepack.json" LogicalName="tubiqo.default-rulepack.json" />
  </ItemGroup>

</Project>
